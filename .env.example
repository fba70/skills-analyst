# Neon Postgres, pooled endpoint, over TCP (`pg`, not the HTTP driver).
# Transactions are required: ingest atomicity, quarantine transitions, and the
# `SET LOCAL app.org_id` RLS backstop all need them.
DATABASE_URL=

# Same database, Neon's direct (unpooled) endpoint: drop "-pooler" from the host.
# Migrations and CREATE INDEX CONCURRENTLY only. The app never uses this.
DATABASE_URL_UNPOOLED=

# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PRODUCTION_URL=

# All model traffic goes through the Vercel AI Gateway. Unused so far.
AI_GATEWAY_API_KEY=

# Cloudflare R2 (S3 API). The ".eu" in the endpoint is required for EU-jurisdiction
# buckets; the plain <account>.r2.cloudflarestorage.com host returns NoSuchBucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_NAME=
# Optional, and NOT the same as R2_ENDPOINT: a Cloudflare custom domain that serves
# validated public bundles to browsers without a signature. None is attached yet, so
# leave this empty — every object is then private and reached through session-gated
# proxy routes. Never point this at the S3 API endpoint; those URLs need signing.
R2_PUBLIC_URL=
