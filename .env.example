# Neon Postgres, pooled endpoint, over TCP (`pg`, not the HTTP driver).
# Transactions are required: ingest atomicity, quarantine transitions, and the
# `SET LOCAL app.org_id` RLS backstop all need them.
DATABASE_URL=

# Same database, Neon's direct (unpooled) endpoint: drop "-pooler" from the host.
# Migrations and CREATE INDEX CONCURRENTLY only. The app never uses this.
DATABASE_URL_UNPOOLED=

# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Where this deployment is reachable. Leave UNSET on Vercel preview deployments: each
# one gets its own hostname, and a value pinned to production makes Better Auth reject
# preview requests as cross-origin. The code falls back to VERCEL_URL there.
BETTER_AUTH_URL=http://localhost:3000

# Where this deployment is reachable. Localhost in development.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The public host printed in documentation — the MCP examples in /faq and on /account.
# Deliberately separate from NEXT_PUBLIC_APP_URL: a copyable snippet must name an address
# the *reader* can reach, and on a laptop that is never localhost.
NEXT_PUBLIC_PRODUCTION_URL=https://skills-foundry.vercel.app

# All model traffic goes through the Vercel AI Gateway. Required for every metered call:
# taxonomy classification, the builder, interview, distill, the eval lab and embeddings.
# The AI SDK reads this variable itself, so nothing in src/ references it by name.
AI_GATEWAY_API_KEY=

# GitHub REST + code search, for ingestion. Unauthenticated requests are rate-limited to
# the point of uselessness against a 49k-skill corpus. A classic PAT with public repo
# read is enough — no write scope is ever used.
GITHUB_TOKEN=

# Cloudflare R2 (S3 API). The ".eu" in the endpoint is required for EU-jurisdiction
# buckets; the plain <account>.r2.cloudflarestorage.com host returns NoSuchBucket.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_NAME=
# NOTE: there is deliberately no R2_PUBLIC_URL here. A Cloudflare custom domain would
# serve bundles without a signature, and R2 grants public access per bucket, never per
# prefix — so a domain on this bucket would expose quarantine/ and drafts/ too. It comes
# back only when public content moves to its own bucket. See CLAUDE.md, Object storage.

# Transactional email — Nylas, which sends from an already-authenticated *mailbox* rather
# than from a verified domain, so there is no DNS to set up and mail leaves under the
# grant's own SPF and DKIM. Both variables are required together: a grant id without a key
# is not a working sender, and discovering that when the first user tries to sign in is the
# failure the check exists to avoid. Sign-in is passwordless, so a deployment with no
# transport is a deployment nobody can log into.
NYLAS_API_KEY=
NYLAS_GRANT_ID=
# Regional API host. https://api.eu.nylas.com for an EU grant.
NYLAS_API_URI=https://api.us.nylas.com
# An OVERRIDE, not the sender. Unset, mail goes as the grant's mailbox, which is the safe
# default; set, it must be a configured send-as alias or the provider refuses the send.
MAIL_FROM=
#   MAIL_TRANSPORT=console  never send, print the code to the terminal
#   MAIL_TRANSPORT=nylas    fail loudly if the credentials above are incomplete
# Pin it to `console` on a laptop. Without it, a local run with Nylas credentials present
# sends real email to whatever address is typed into the sign-in form.
MAIL_TRANSPORT=console

# Comma-separated emails granted the SYSTEM admin role on sign-up. Distinct from
# organisation roles: this is platform-wide (all users, ingestion, policy).
ADMIN_EMAILS=

# Scheduled ingest (Doc 2 R1.7). Vercel Cron sends this as `Authorization: Bearer <value>`
# on every call to /api/cron/pipeline. The route refuses when it is unset — an
# unauthenticated endpoint that fetches hundreds of repositories on demand is a
# denial-of-wallet against our own GitHub budget, so it fails closed rather than open.
# Any long random string; generate with `openssl rand -hex 32`.
CRON_SECRET=

# Outcome-telemetry dedup (R6.3, R6.5). One download by one reader on one day counts once,
# and the identity behind it is a daily-rotating HMAC with the day inside the key, so
# yesterday's digests cannot be recomputed from today's salt.
#
# Unset, every caller collides and a skill records at most one download a day. That is the
# chosen direction — a signal that can move published guidance must never fail towards
# counting *more* — but it silently undercounts, so set it anywhere the numbers are read.
OUTCOME_SALT=

# Billing webhooks (RC.4). The shared secret the provider signs each delivery with; the
# route refuses every delivery when it is unset, for the same reason CRON_SECRET does.
# Nothing upstream of this exists yet: there is no checkout flow, so an unrecognised
# customer is recorded `unmapped` and an admin links it by hand.
BILLING_WEBHOOK_SECRET=

# The deployment-wide model kill switch. UNSET MEANS OFF.
#
# Off, `assertWithinBudget` and `assertConversationBudget` refuse before any model is reached,
# so every generation, interview, distill, eval, optimiser, parameter detection, similarity and
# embedding call is refused with a sentence — and the surfaces that offer them are not
# rendered. Everything that is server compute is unaffected: sign-up, sign-in, registry search,
# skill pages, manual authoring, validation, publishing, export, and the MCP reads.
#
# Default-off rather than default-on for the reason CRON_SECRET fails closed: the case worth
# protecting is a deployment somebody forgot to configure, and the safe direction is a refusal
# carrying an explanation rather than a bill. Set it to 1 in a local shell, where the metered
# corpus scripts and the three suites that spend need it; leave it unset on the deployment.
#
#   LLM_ENABLED=1     models are called, metered and capped by the two budgets below
#   (unset)           no model is called by anybody, for any purpose
LLM_ENABLED=1

# Spend caps (RC.2), in whole dollars. Two budgets on purpose: the per-org cap stops one
# customer running up a bill, the platform cap stops our own corpus analysis doing the
# same, and mixing them would let either failure cause the other. These are the defaults;
# both fail closed by refusing the call, never by degrading to a cheaper model.
LLM_ORG_MONTHLY_CAP_USD=5
LLM_PLATFORM_MONTHLY_CAP_USD=50
